[Unit]
Description=Encrypted MémoCycle PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=memocycle
Group=memocycle
WorkingDirectory=/opt/memocycle
EnvironmentFile=/etc/memocycle/backup.env
ExecStart=/opt/memocycle/infra/backup.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/memocycle

